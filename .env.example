# =============================================================================
# secrets/environment template — SAFE TO COMMIT
# Copy to .env and fill in real values:   Copy-Item .env.example .env
#
# .env is in .gitignore and is verified as untracked by Gatekeeper on every
# run. Never paste a real key into this file.
# =============================================================================

# --- Solana providers -------------------------------------------------------
# Helius: mainnet RPC, LaserStream WSS, and the Sender transaction router.
# Free plan: 1M credits/month, 10 req/s, sendTransaction 1/s.
# Note: LaserStream gRPC on MAINNET requires Business+; on DEVNET it is free.
HELIUS_API_KEY=

# Jupiter Developer Platform: one key for swap /order and /build.
# https://developers.jup.ag/portal — start free, no card.
JUPITER_API_KEY=

# --- wallet -----------------------------------------------------------------
# Path to the hot wallet secret key. The file lives OUTSIDE the repository.
# The hot wallet only ever holds the trading float (see HOT_WALLET_MAX_SOL).
HOT_WALLET_KEYFILE=
# Safety rail enforced at startup: refuse to run if the hot wallet holds more.
HOT_WALLET_MAX_SOL=0.5

# --- execution (all optional, sensible defaults built in) -------------------
# Jito block engine. Regional endpoints exist for Frankfurt/Amsterdam/NY/SLC/
# Singapore/Tokyo/Dublin/London; the global one works from anywhere.
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Minimum tip in lamports. Jito refuses bundles below 1000.
JITO_MIN_TIP_LAMPORTS=1000
# Free endpoints that reveal what the auction currently pays.
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor

# Helius Sender: credit-free, paid for entirely with the SOL tip.
#   Sender Max   -> tip >= 0.001 SOL enters the priority tip buffer
#   SWQOS-only   -> tip >= 0.000005 SOL, single fast path
HELIUS_SENDER_URL=https://mainnet.helius-rpc.com/?api-key=

# --- Yellowstone gRPC (only needed once free WSS detection proves too slow) --
# Free on devnet for any Helius plan; mainnet requires Business+.
YELLOWSTONE_GRPC_ENDPOINT=
YELLOWSTONE_GRPC_TOKEN=

# --- risk -------------------------------------------------------------------
# SolanaTracker: 0-10 risk score per token, free tier 2500 requests/month.
SOLANATRACKER_API_KEY=
# Rugcheck needs no key.
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1

# --- deployment (server bootstrap, never read by the trading process) -------
# Only used by the deployment script; the bot itself must never need it.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY=